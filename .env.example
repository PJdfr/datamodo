# ---------------------------------------------------------------------------
# Template of the environment variables this project expects.
# Copy to .env.local and fill in real values. NEVER commit .env.local.
# ---------------------------------------------------------------------------

# --- App ---
# Base URL used for auth email/OAuth redirects. Localhost in dev, real domain in prod.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret for the /api/ingest webhook. Provider adapters send it in the
# x-ingest-secret header. Generate with: openssl rand -hex 32
INGEST_WEBHOOK_SECRET=

# Protects the extraction consumer (/api/jobs/extract-tick). The Supabase pg_cron
# job (migration 20260709120000) POSTs to it every minute with
# `Authorization: Bearer <CRON_SECRET>`, reading the value from Supabase Vault
# (secret name `extraction_cron_secret`). Set the SAME value here (so the route
# validates it) and in Vault. Generate with: openssl rand -hex 32
CRON_SECRET=
# Optional: how many queued items each cron tick drains (default 3; raise on
# Vercel Pro where functions can run longer than Hobby's 60s cap).
# EXTRACT_BATCH=3

# --- Supabase client (browser + Next.js SSR via @supabase/ssr) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# --- Supabase server / backend handlers (@supabase/server) ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Secret key — keep private, server-side only. Never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_xxx
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# --- Prisma (Postgres via Supabase poolers) ---
# Transaction-mode pooler (IPv4-only) — used by the app at runtime.
DATABASE_URL="postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session-mode pooler — used for migrations.
DIRECT_URL="postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Billing (optional; upgrades are inert until these are set) ---
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# STRIPE_PRICE_PRO=price_xxx
# STRIPE_PRICE_MAX=price_xxx
