# ---------------------------------------------------------------------------
# Template of the environment variables this project expects.
# Copy to .env.local and fill in real values. NEVER commit .env.local.
# ---------------------------------------------------------------------------

# --- App ---
# Base URL used for auth email/OAuth redirects. Localhost in dev, real domain in prod.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret for the /api/ingest webhook. Provider adapters send it in the
# x-ingest-secret header. Generate with: openssl rand -hex 32
INGEST_WEBHOOK_SECRET=

# --- Neon Postgres (Prisma via @prisma/adapter-neon) ---
# Pooled connection — used by the app at runtime. From the Neon Console (or the
# Neon-Vercel integration). Point at the `dev` branch for local dev.
DATABASE_URL="postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/neondb?sslmode=require"
# Unpooled/direct — used for migrations / prisma db pull.
DIRECT_URL="postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/neondb?sslmode=require"

# --- Billing (optional; upgrades are inert until these are set) ---
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# STRIPE_PRICE_PRO=price_xxx
# STRIPE_PRICE_MAX=price_xxx

# --- Neon Auth (Better Auth) ---
# Auth URL from the Neon Console (Project > Branch > Auth > Configuration).
NEON_AUTH_BASE_URL=https://<endpoint>.neonauth.<region>.aws.neon.tech/neondb/auth
# Cookie signing secret. Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# --- Object storage (raw-message archive) — S3-compatible ---
# Works with Neon Object Storage (private preview, us-east-2 only right now),
# Cloudflare R2, or any S3 bucket. store.ts throws if these are unset.
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BLOB_BUCKET=ingest

# --- Extraction cron (GitHub Actions -> /api/jobs/extract-tick) ---
# Shared secret the cron sends as `Authorization: Bearer <CRON_SECRET>`.
# Set the SAME value as a GitHub Actions secret (plus APP_URL). openssl rand -hex 32
CRON_SECRET=
# Items drained per tick (default 3).
# EXTRACT_BATCH=3
